# Google Gemini API Key (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-pro
# Max output tokens for LLM response (8192 recommended for 60+ minute meetings)
GEMINI_MAX_OUTPUT_TOKENS=8192

# Notion Integration Token
# Get it from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# Notion Page ID where meeting minutes will be appended
# Example: If your page URL is https://notion.so/workspace/abc123def456
# Then your page ID is: abc123def456 (the part after the last slash, before any query params)
NOTION_PAGE_ID=your_notion_page_id_here

# Streamlit Server Configuration (for network access)
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501

# Whisper Model Configuration
# Options: tiny, base, small, medium, large, large-v2, large-v3
# Default: large-v3 (optimized for RTX 3060 12GB)
# Fallback on OOM: large-v2
WHISPER_MODEL=large-v3
WHISPER_FALLBACK_MODEL=large-v2

# Telegram Bot Configuration (for notifications)
# 1. Create a bot via @BotFather on Telegram
# 2. Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Whisper HTTP Server (for Mac remote processing via Tailscale)
WHISPER_SERVER_URL=http://100.71.112.103:8765

# Soomgo Client Meeting Minutes - Notion Database ID
SOOMGO_NOTION_DB_ID=your_soomgo_notion_db_id_here

# Telegram per-user Chat IDs (for multi-user notifications)
TELEGRAM_CHAT_ID_USER1=your_chat_id_here
TELEGRAM_CHAT_ID_USER2=teammate_chat_id_here
